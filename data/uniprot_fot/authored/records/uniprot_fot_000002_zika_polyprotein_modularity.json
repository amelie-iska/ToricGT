        "training_role": "replication_and_processing"
      }
    },
    {
      "id": "n4_rejected_single_function",
      "type": "rejected_branch",
      "content": "A single-label answer such as 'capsid protein' is wrong for the whole row because it selects one cleavage product and discards the polyprotein organization and the non-structural enzymatic modules.",
