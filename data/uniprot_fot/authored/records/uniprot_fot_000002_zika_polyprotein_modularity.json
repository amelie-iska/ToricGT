        "training_role": "assembly_and_entry"
      }
    },
    {
      "id": "n3_nonstructural_tree",
      "type": "reasoning_tree",
      "content": "Non-structural products should be grouped by replication and host-modulation roles. NS2B is a regulatory subunit for the NS3 serine protease, while NS3 also carries NTPase/helicase-like enzyme labels in the source name.",
      "latent_coordinates": [0.11, 0.36, 0.43, 0.02, 0.62, -0.11, 0.37, 0.31],
      "symbolic_payload": {
        "tree": "nonstructural_module",
