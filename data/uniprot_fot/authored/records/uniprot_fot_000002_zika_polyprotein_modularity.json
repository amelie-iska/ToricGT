      "symbolic_payload": {
        "rejected_label": "single_cleavage_product_as_whole_function",
        "failure_mode": "module_collapse"
      }
    },
    {
      "id": "n5_merge_modular_annotation",
      "type": "merge",
      "content": "The useful target is a modular annotation: one source sequence encodes a cleaved polyprotein, and each product has local function. The merge preserves both global precursor identity and product-level specialization.",
      "latent_coordinates": [0.18, 0.41, 0.51, 0.09, 0.68, -0.05, 0.42, 0.38],
      "symbolic_payload": {
        "merge_inputs": ["n2_structural_tree", "n3_nonstructural_tree", "n4_rejected_single_function"],
        "module_boundary_signal": "cleavage product list"
      }
    },
    {
      "id": "n6_design_and_safety",
      "type": "safety_aware_design_condition",
      "content": "For biomedical training, this record should teach mechanism and modularity, not operational viral engineering. Safe design reasoning can focus on annotation parsing, epitope or inhibitor-target abstraction, and avoiding claims that provide actionable pathogen optimization.",
      "latent_coordinates": [0.21, 0.43, 0.55, 0.12, 0.71, -0.02, 0.47, 0.42],
      "symbolic_payload": {
        "safe_focus": ["annotation parsing", "module boundaries", "host-pathway mechanism", "therapeutic target abstraction"],
        "avoid": ["pathogen optimization protocol", "infectivity enhancement"]
      }
    },
    {
      "id": "n7_answer",
      "type": "answer",
      "content": "Represent the row as a cleaved viral polyprotein with structural and non-structural function forests: particle assembly/entry modules on one side, replication-processing enzymes on the other, joined by cleavage-product boundaries.",
      "latent_coordinates": [0.25, 0.47, 0.59, 0.16, 0.74, 0.02, 0.51, 0.46],
      "symbolic_payload": {
        "final_label": "cleaved viral genome polyprotein with modular product functions",
