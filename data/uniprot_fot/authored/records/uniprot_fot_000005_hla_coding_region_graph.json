    {"id": "n3_tree_immunological_function", "type": "reasoning_tree", "content": "The protein-function tree should recognize HLA-B as an MHC class I heavy-chain context: sequence variation can shape peptide presentation, but the row alone does not justify patient-specific transplant or disease predictions.", "latent_coordinates": [0.25, -0.03, 0.37, 0.67, 0.39, 0.13, 0.47, 0.19], "symbolic_payload": {"tree": "immunological_function_tree", "safe_scope": "mechanism-level antigen-presentation reasoning"}},
