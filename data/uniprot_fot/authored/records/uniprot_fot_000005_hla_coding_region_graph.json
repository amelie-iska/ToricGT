    {"id": "n0_problem", "type": "problem", "content": "A coding-region row contains a Homo sapiens HLA-B genomic sequence, exon features, and one translated protein. Build a graph reasoning target that connects genomic coordinates to protein-level immunological function without overclaiming allele-specific clinical advice.", "latent_coordinates": [0.1, -0.22, 0.18, 0.49, 0.25, -0.05, 0.32, 0.04], "symbolic_payload": {"accession": "PV930210.1", "gene": "HLA-B", "organism": "Homo sapiens"}},
